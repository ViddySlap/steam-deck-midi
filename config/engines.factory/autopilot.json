{
  "name": "Autopilot",
  "type": "autopilot",
  "enabled": true,
  "update_hz": 30,
  "column_quantize": true,
  "tempo_source": {
    "kind": "midi_clock",
    "port": "PULSE_OUT",
    "ppqn": 24
  },
  "fallback_clock": {
    "_comment": "Free-running internal clock for shows without Pulse. Takes over when no MIDI clock tick has arrived for takeover_after_seconds, and hands straight back the moment real ticks resume.",
    "enabled": true,
    "bpm": 128.0,
    "takeover_after_seconds": 2.0
  },
  "inputs": {
    "channel": 14,
    "video": {
      "cc_enable": 60,
      "cc_beats": 61,
      "cc_transition": 62,
      "cc_mode": 63,
      "layer_ccs": {"1": 64, "2": 65, "3": 66, "4": 67},
      "group": 1,
      "column_advance": true
    },
    "fx": {
      "cc_enable": 70,
      "cc_beats": 71,
      "cc_transition": 72,
      "cc_mode": 73,
      "layer_ccs": {"5": 74},
      "_comment": "FX is layer 5, which is NOT inside a Resolume layer group, so there is no /composition/groups/N to advance -- group stays null and column_advance stays false by design. FX advances to the next CLIP on its own layer instead, which the single-layer path already does every beats_per_clip whenever MODE is LINEAR or RANDOM. Set the fx MODE selector to LINEAR to get it.",
      "group": null,
      "column_advance": false
    },
    "logo": {
      "cc_enable": 80,
      "cc_beats": 81,
      "cc_transition": 82,
      "cc_mode": 83,
      "layer_ccs": {"6": 84, "7": 85},
      "group": 2,
      "column_advance": true
    },
    "transition_max_seconds": 5.0,
    "beats_lookup": [1, 4, 8, 16, 32, 64, 128]
  },
  "outputs": {
    "osc": {"host": "127.0.0.1", "port": 7000},
    "rest": {"base_url": "http://127.0.0.1:8080", "timeout_seconds": 1.5}
  },
  "defaults": {
    "video": {"beats_per_clip": 16, "transition_seconds": 0.0, "clip_mode": 0},
    "fx": {"beats_per_clip": 16, "transition_seconds": 0.0, "clip_mode": 0},
    "logo": {"beats_per_clip": 16, "transition_seconds": 0.0, "clip_mode": 0}
  }
}
